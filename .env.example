# Environment Variables for Shanti Digital Agency (SDA) CMS

# Application URL
APP_URL="https://shantidigitalagency.com"
NEXT_PUBLIC_SITE_URL="https://shantidigitalagency.com"

# PostgreSQL Database (Prisma + Connection Pooling)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sda_cms?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/sda_cms?schema=public"

# Cloud SQL Platform Variables (if deploying on Google Cloud Platform)
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="sda_cms"

# JWT Authentication Secret
JWT_SECRET="sda-production-super-secure-jwt-secret-replace-in-env-2026"
AUTH_SECRET="sda-production-super-secure-jwt-secret-replace-in-env-2026"

# Vercel Blob / Persistent Media Storage
# For Vercel Blob:
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_placeholder"

# S3 Compatible Storage Fallback (AWS S3, Cloudflare R2, MinIO, Supabase Storage):
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="sda-media"
STORAGE_REGION="auto"

# Lead Webhook Integration (n8n, EspoCRM, Zapier, WhatsApp CRM)
WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/sample/sda_crm_inbox"
WEBHOOK_SECRET=""
